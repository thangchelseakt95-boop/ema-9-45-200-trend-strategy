//@version=6
// EMA9 / EMA45 / EMA200 — Breakout hoặc Pullback V5 (chuyển từ backtest Python của dự án btc-ema-backtest-project)
// Luật (xem README.md của dự án):
//   * Lọc xu hướng: EMA9 > EMA45 > EMA200, bỏ qua 200 nến đầu (làm nóng EMA).
//   * Breakout: EMA9 cắt lên EMA45 -> lệnh chờ mua (stop) ở đỉnh nến tín hiệu.
//   * Pullback V5: sau khi cắt lên, nến tín hiệu = nến chạm EMA45 nhưng đóng cửa trên EMA45,
//     hoặc nến đầu tiên đóng cửa trở lại trên EMA45 sau khi đã đóng cửa dưới EMA45; lệnh chờ ở đỉnh nến đó.
//   * Lệnh chờ mua tự hủy nếu EMA9 cắt xuống EMA45 trước khi khớp; mỗi lần cắt lên chỉ vào tối đa 1 lệnh.
//   * SL = giá vào - k x ATR(14) (ATR của nến ngay trước nến vào lệnh).
//   * Thoát: EMA9 cắt xuống EMA45 -> lệnh chờ bán ở đáy nến cắt xuống; hủy nếu EMA9 cắt lên lại trước khi khớp.
// Khác biệt nhỏ so với backtest Python:
//   * Khi SL và mức thoát breakdown cùng bị chạm trong một nến, script thoát ở mức cao hơn (mức giá chạm trước),
//     còn backtest Python ưu tiên SL.
//   * SL chạm ngay trong nến vào lệnh do bộ giả lập của TradingView quyết định theo OHLC (hoặc Bar Magnifier nếu bật),
//     không phải giả định bất lợi / nến H1 như backtest.
//   * TradingView chỉ tải một số nến lịch sử giới hạn, nên điểm bắt đầu EMA và kết quả có thể lệch với backtest.
strategy("EMA9/45/200 Breakout & Pullback V5", overlay = true, initial_capital = 1000, currency = currency.USD,
         pyramiding = 0, commission_type = strategy.commission.percent, commission_value = 0.04,
         default_qty_type = strategy.fixed, default_qty_value = 1,
         margin_long = 10, margin_short = 10, max_labels_count = 500)   // đòn bẩy 10x: khi ATR thấp, lệnh rủi ro 1% có giá trị lớn hơn vốn; Pine v6 mặc định ký quỹ 100% nên sẽ bỏ qua các lệnh đó

// ---------- Inputs ----------
mode       = input.string("Breakout", "Kiểu vào lệnh", options = ["Breakout", "Pullback V5"])
atrMult    = input.float(2.5, "SL = k x ATR(14)", minval = 0.5, step = 0.5, tooltip = "Khuyến nghị: BTC H1 Breakout 2.5; vàng H4 Breakout 2.0-3.5 hoặc Pullback V5 2.0-2.5")
riskPct    = input.float(1.0, "Rủi ro mỗi lệnh (% vốn)", minval = 0.1, step = 0.1)
maxLev     = input.float(10, "Đòn bẩy tối đa (giới hạn khối lượng)", minval = 1, step = 1, tooltip = "Giá trị lệnh không vượt quá vốn x hệ số này để TradingView luôn khớp lệnh. Giữ Properties > Margin for long positions không lớn hơn 100 / hệ số này (10 -> margin 10). Khi chạm giới hạn, rủi ro thực tế nhỏ hơn % rủi ro ở trên.")
fastLen    = input.int(9, "EMA nhanh", minval = 1)
slowLen    = input.int(45, "EMA chậm", minval = 2)
trendLen   = input.int(200, "EMA xu hướng", minval = 2)
warmupBars = input.int(200, "Số nến làm nóng EMA", minval = 0)
startDate  = input.time(timestamp("2021-01-01T00:00:00"), "Chỉ vào lệnh từ ngày")

// ---------- Chỉ báo (EMA khởi tạo từ giá đầu tiên, giống pandas ewm(adjust=False)) ----------
emaSeed(float src, int len) =>
    float alpha = 2.0 / (len + 1)
    var float e = na
    e := na(e) ? src : alpha * src + (1 - alpha) * e
    e

e9   = emaSeed(close, fastLen)
e45  = emaSeed(close, slowLen)
e200 = emaSeed(close, trendLen)
atr  = emaSeed(ta.tr(true), 14)

up       = e9 > e45
crossUp  = up and not up[1]
crossDn  = not up and up[1]
aligned  = e9 > e45 and e45 > e200 and bar_index >= warmupBars and time >= startDate

// ---------- Trạng thái ----------
var float pending     = na     // mức chờ mua (đỉnh nến tín hiệu)
var bool  waiting     = false  // Pullback: đang chờ giá hồi về EMA45
var bool  below       = false  // Pullback: giá đã đóng cửa dưới EMA45
var float exitLevel   = na     // mức chờ thoát (đáy nến cắt xuống)
var float slDist      = na     // khoảng SL = k x ATR của nến trước nến vào lệnh
var float slPrice     = na
var float entryPx     = na     // giá khớp của lệnh hiện tại / gần nhất
var float orderLvl    = na     // mức chờ mua có hiệu lực ở nến này (đặt lúc đóng nến trước)
var bool  inPos       = false
var float risk1R      = na     // 1R của lệnh hiện tại / gần nhất, cố định lúc khớp

// Vị thế theo luật, tính từ OHLC của từng nến, không phụ thuộc Strategy Tester (ký quỹ, khối lượng): mọi nhãn, mức giá và cảnh báo đều dựa vào đây
bool  filled = false
bool  closed = false
float exitPx = na
if not inPos and not na(orderLvl) and high >= orderLvl
    entryPx := math.max(orderLvl, open)          // mở cửa vượt mức chờ -> khớp ở giá mở cửa
    slPrice := entryPx - slDist
    risk1R  := slDist
    inPos   := true
    filled  := true
    pending := na
    waiting := false
    below   := false
    if low <= slPrice                            // chạm SL ngay trong nến khớp: giả định bất lợi (giống backtest Python khung H1)
        inPos  := false
        closed := true
        exitPx := slPrice
else if inPos
    float activeStop = na(exitLevel) ? slPrice : math.max(slPrice, exitLevel)
    if low <= activeStop
        inPos  := false
        closed := true
        exitPx := math.min(activeStop, open)     // mở cửa dưới mức dừng -> thoát ở giá mở cửa
bool flat = not inPos

if flat
    exitLevel := na
    if mode == "Breakout"
        if not na(pending) and crossDn
            pending := na                       // EMA đảo chiều trước khi breakout -> hủy
        if crossUp and aligned
            pending := high
    else
        if crossUp and aligned
            waiting := true
            pending := na
            below   := false
        if waiting
            if crossDn
                waiting := false
                pending := na
                below   := false
            else if not filled
                if close < e45
                    below   := true             // cắt xuống -> đợi nến cắt lại
                    pending := na
                else if below and close > e45 and up and aligned
                    pending := high             // nến đầu tiên đóng cửa trở lại trên EMA45
                    below   := false
                else if not below and na(pending) and low <= e45 and up and aligned
                    pending := high             // chạm EMA45 rồi đóng cửa trên
else
    if not na(exitLevel) and crossUp
        exitLevel := na                         // EMA9 cắt lên lại -> hủy lệnh chờ thoát
    if crossDn
        exitLevel := low

// ---------- Lệnh ----------
bool canEnter = flat and not na(pending) and aligned and (mode == "Breakout" or up)
if canEnter
    slDist := atrMult * atr
    float riskQty = strategy.equity * riskPct / 100 / slDist
    float maxQty  = strategy.equity * maxLev * 0.95 / pending   // giữ lệnh trong giới hạn ký quỹ để TradingView khớp được
    float qty     = math.min(riskQty, maxQty)
    strategy.entry("Long", strategy.long, qty = qty, stop = pending)
    strategy.exit("Exit", from_entry = "Long", loss = slDist / syminfo.mintick)   // SL theo giá khớp thật, có hiệu lực ngay trong nến vào lệnh
else
    strategy.cancel("Long")
orderLvl := canEnter ? pending : na
if flat and strategy.position_size > 0
    strategy.close("Long")   // chỉ cho Strategy Tester: không giữ vị thế khi luật đã đóng lệnh

if not flat and strategy.position_size > 0
    float stopLvl = na(exitLevel) ? slPrice : math.max(slPrice, exitLevel)
    strategy.exit("Exit", from_entry = "Long", stop = stopLvl)

// ---------- Hiển thị ----------
plot(e9, "EMA9", color = color.new(color.aqua, 0))
plot(e45, "EMA45", color = color.new(color.orange, 0), linewidth = 2)
plot(e200, "EMA200", color = color.new(color.gray, 0), linewidth = 2)
plot(canEnter ? pending : na, "Mức chờ mua", color = color.green, style = plot.style_circles, linewidth = 2)
plot(not flat or filled ? slPrice : na, "Stop loss", color = color.red, style = plot.style_circles, linewidth = 2)
plot(not flat ? exitLevel : na, "Mức chờ thoát", color = color.fuchsia, style = plot.style_circles, linewidth = 2)
plotshape(crossUp and aligned, "Tín hiệu cắt lên", shape.triangleup, location.belowbar, color.green, size = size.tiny)
plotshape(crossDn, "EMA9 cắt xuống", shape.triangledown, location.abovebar, color.red, size = size.tiny)

// ---------- Đánh dấu vào lệnh: nhãn LONG kèm giá vào, SL và rủi ro ở nến khớp ----------
plot(not flat or filled ? entryPx : na, "Giá vào lệnh", color = color.new(color.blue, 0), style = plot.style_circles, linewidth = 2)
if filled
    string txt = "LONG\nVào " + str.tostring(entryPx, format.mintick) + "\nSL " + str.tostring(slPrice, format.mintick) + "\n1R = " + str.tostring(risk1R, format.mintick) + (flat ? "\nChạm SL ngay trong nến" : "")
    label.new(bar_index, low, txt, yloc = yloc.belowbar, style = label.style_label_up, color = color.new(color.green, 10), textcolor = color.white, size = size.small)
if closed
    float rMult = (exitPx - entryPx) / risk1R
    label.new(bar_index, high, "THOÁT " + str.tostring(exitPx, format.mintick) + "\n" + (rMult >= 0 ? "+" : "") + str.tostring(rMult, "#.##") + "R", yloc = yloc.abovebar, style = label.style_label_down, color = rMult >= 0 ? color.new(color.teal, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)

// ---------- SL dự kiến và các mức đang hiệu lực ----------
float projSL = canEnter ? pending - atrMult * atr : na   // SL nếu lệnh chờ mua khớp đúng ở mức chờ
plot(projSL, "SL dự kiến", color = color.new(color.red, 50), style = plot.style_circles, linewidth = 2)
plot(atr, "ATR(14)", display = display.data_window)
plot(atrMult * atr, "Khoảng SL (k x ATR)", display = display.data_window)

// plot() cần 2 nến mới vẽ được đường, nên các mức cho nến tiếp theo được vẽ thêm từ nến đã đóng mới nhất kéo sang phải
// (vẽ lại ở mỗi nến đã đóng: strategy chỉ chạy khi nến đóng nên barstate.islast không đáng tin ở đây)
drawLevel(line oldLn, label oldLb, float price, color col, string txt) =>
    line.delete(oldLn)
    label.delete(oldLb)
    line  ln = na
    label lb = na
    if not na(price)
        ln := line.new(bar_index, price, bar_index + 1, price, color = col, style = line.style_dashed, width = 2, extend = extend.right)
        lb := label.new(bar_index + 2, price, txt + " " + str.tostring(price, format.mintick), style = label.style_label_left, color = color.new(col, 85), textcolor = col, size = size.small)
    [ln, lb]

var line  lnBuy  = na
var label lbBuy  = na
var line  lnProj = na
var label lbProj = na
var line  lnSL   = na
var label lbSL   = na
var line  lnExit = na
var label lbExit = na
if barstate.isconfirmed
    [l1, b1] = drawLevel(lnBuy, lbBuy, canEnter ? pending : na, color.green, "Chờ mua")
    lnBuy := l1
    lbBuy := b1
    [l2, b2] = drawLevel(lnProj, lbProj, projSL, color.new(color.red, 30), "SL dự kiến")
    lnProj := l2
    lbProj := b2
    [l3, b3] = drawLevel(lnSL, lbSL, not flat ? slPrice : na, color.red, "Stop loss")
    lnSL := l3
    lbSL := b3
    [l4, b4] = drawLevel(lnExit, lbExit, not flat ? exitLevel : na, color.fuchsia, "Chờ thoát")
    lnExit := l4
    lbExit := b4

// ---------- Cảnh báo: tạo alert trên strategy này và chọn "alert() function calls only" ----------
string tag = syminfo.ticker + " " + timeframe.period + ": "
fmt(float x) => str.tostring(x, format.mintick)
if canEnter and (not canEnter[1] or pending != pending[1])
    alert(tag + "CHỜ MUA " + fmt(pending) + " | SL dự kiến " + fmt(projSL) + " | khoảng SL " + fmt(atrMult * atr) + " (" + str.tostring(atrMult) + " x ATR)", alert.freq_once_per_bar_close)
if canEnter[1] and not canEnter and not filled
    alert(tag + "Hủy lệnh chờ mua " + fmt(pending[1]), alert.freq_once_per_bar_close)
if filled and not flat
    alert(tag + "ĐÃ KHỚP MUA " + fmt(entryPx) + " | stop loss " + fmt(slPrice) + " | khoảng SL " + fmt(risk1R), alert.freq_once_per_bar_close)
if filled and flat
    alert(tag + "Lệnh mua khớp rồi chạm SL ngay trong nến", alert.freq_once_per_bar_close)
if not flat and crossDn
    alert(tag + "CHỜ THOÁT " + fmt(exitLevel) + " | stop loss " + fmt(slPrice) + " | mức dừng hiệu lực " + fmt(math.max(slPrice, exitLevel)), alert.freq_once_per_bar_close)
if not flat and crossUp and not na(exitLevel[1])
    alert(tag + "Hủy lệnh chờ thoát (EMA9 cắt lên lại EMA45) | stop loss " + fmt(slPrice), alert.freq_once_per_bar_close)
if closed and not filled
    alert(tag + "ĐÃ ĐÓNG LỆNH ở " + fmt(exitPx) + " (" + str.tostring((exitPx - entryPx) / risk1R, "#.##") + "R)", alert.freq_once_per_bar_close)
